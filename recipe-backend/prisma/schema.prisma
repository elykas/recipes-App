// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  seed     = "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


model User {
  id         Int     @id @default(autoincrement()) 
  publicId   String  @unique @default(uuid())     
  email      String?  @unique
  username   String   @unique
  fullName   String?
  phone      String?  @unique
  imageUrl   String?
  bio        String?
  headLine   String?
  isAdmin    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastLogin  DateTime?
  locale     String?  @default("en")
  recipes        Recipe[]     @relation("UserRecipes")
  posts          Post[]       @relation("UserPosts")
  comments       Comment[]    @relation("UserComments")
  postLikes      PostLike[]   @relation("UserPostLikes")
  recipeLikes    RecipeLike[] @relation("UserRecipeLikes")
  favorites      FavoriteRecipes[]   @relation("UserFavorites")
  followers      Follower[]   @relation("UserFollowersFollowing", references: [followerId])
  following      Follower[]   @relation("UserFollowersFollowing", references: [followingId])
  groups         GroupMember[]
  notifications  Notification[]
  userEvents     UserEvent[]
}

model Recipe {
  id          Int     @id @default(autoincrement()) 
  publicId    String  @unique @default(uuid())     
  title       String   
  categories  Category[]  
  steps       Step[]
  favorites   Favorite[]
  comments    Comment[]
  posts       Post[]
  tags        RecipeTag[]
  likes       RecipeLike[]
  prepTime    Int? @default(30)
  imageUrl    String?
  ingredients Ingredient[] 
  description String?
  difficulty  DifficultyLevel @default(Easy)
  isPublic    Boolean @default(false)
  author      User    @relation("UserRecipes", fields: [authorId], references: [id], onDelete: Cascade)
  authorId    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum DifficultyLevel {
  Easy
  Medium
  Hard
}

model Ingredient {
  id  Int  @id @default(autoincrement())
  name     String  
  quantity String?
  unit     String?
  recipeId Int
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Category {
  id       Int  @id @default(autoincrement())
  name     String @unique
  type     CategoryType
  recipes  Recipe[]  
}

enum CategoryType {
  MealType         // e.g. Breakfast, Dinner
  MainIngredient   // e.g. Chicken, Tofu
  Cuisine          // e.g. Italian, Japanese
  DietaryPreference // e.g. Vegan, Gluten-Free
  CookingMethod    // e.g. Air Fryer, Grilled
  Occasion         // e.g. Holiday, Party
  SkillLevel       // e.g. Beginner, Advanced
  PreparationTime  // e.g. Under30Minutes
  Equipment        // e.g. SlowCooker, InstantPot
  Audience         // e.g. KidFriendly, BudgetFriendly
  NutritionFocus   // e.g. HighProtein, LowFat
  Seasonality      // e.g. Summer, Winter
  FlavorProfile    // e.g. Spicy, Sweet
  Texture          // e.g. Crunchy, Creamy
}

model Step {
  id          Int  @id @default(autoincrement())
  title       String?
  description String
  imageUrl    String?
  duration    Int?
  recipeId    Int
  recipe      Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Group {
  id          Int      @id @default(autoincrement())
  publicId    String   @unique @default(uuid())
  name        String
  creator     User?         @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  creatorId   Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     GroupMember[]
  recipes     Recipe[]   
}

model GroupMember {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   Int
  admin     Boolean  @default(false)
  joinedAt  DateTime @default(now())
  @@unique([userId, groupId])
}

model FavoriteRecipes {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId  Int
  createdAt DateTime @default(now())
  @@unique([userId, recipeId]) 
}

model Post {
  id          Int      @id @default(autoincrement())
  publicId    String  @unique @default(uuid())     
  authorId    Int
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  type        PostType @default(IMAGE) 
  content     String?  
  imageUrl    String?  
  recipeId    Int?
  recipe      Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  tags        RecipeTag[]
  likes       PostLike[]
  comments    Comment[]
}

enum PostType {
  TextBg     
  Image   
  Video
}

model PostLike {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int
  type      LikeType @default(LIKE)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model RecipeLike {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId  Int
  type      LikeType @default(LIKE)
  createdAt DateTime @default(now())

  @@unique([userId, recipeId])
}

//HAVE TO FIX IT BY OUR APP 
enum LikeType {
  Like      
  Love    
  Haha
  Wow       
  Sad       
  Angry            
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  Int
  recipe    Recipe?  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId  Int?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int?
  parent    Comment? @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentThread")
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int      // מי שעוקב
  followingId Int      // מי שעוקבים אחריו
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  @@unique([followerId, followingId]) 
}

model Tag {
  id         Int       @id @default(autoincrement())
  publicId   String    @unique @default(uuid())
  name       String    @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  recipes    RecipeTag[]
  posts      PostTag[] 
}

model PostTag {
  id      Int     @id @default(autoincrement())
  postId  Int
  tagId   Int
  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@unique([postId, tagId])
}

model RecipeTag {
  id        Int     @id @default(autoincrement())
  recipeId  Int
  tagId     Int
  recipe    Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@unique([recipeId, tagId])
}

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int      // למי מיועדת ההתראה
  type        NotificationType
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  Like
  Comment
  Follow
  NewPost
  NewRecipe
  System
  CommentReply
  Mention
  Search
  WeeklyDigest
  Trending
  TagFollowed
}

model UserEvent {
  id         Int      @id @default(autoincrement())
  userId     Int
  eventType  EventType
  metadata   Json?    // פרטים נוספים על האירוע, כמו מזהה של פוסט, מתכון, זמן וכו'
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum EventType {
  Login
  Logout
  ViewRecipe
  ViewPost
  CreateRecipe
  CreatePost
  Like
  Comment
  Follow
  Unfollow
  UpadateProfile
  Search
  Share
  ClickNotification
}
