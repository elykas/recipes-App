// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  seed     = "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


model User {
  id               Int       @id @default(autoincrement())
  username         String    
  email            String?   @unique 
  phone            String?   @unique
  googleId         String?   @unique
  isAdmin          Boolean   @default(false)
  imageUrl         String?
  bio              String?
  recipes          Recipe[]  @relation("UserRecipes")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Recipe {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  categories  Category[]  
  steps     String[]
  prepTime  Int? @default(30)
  imageUrl  String?
  ingredients Ingredient[] 
  author    User    @relation("UserRecipes", fields: [authorId], references: [id])
  authorId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ingredient {
  id  Int  @id @default(autoincrement())
  name String  
  quantity String?
  unit String?
  
  recipeId  Int
  recipe    Recipe  @relation(fields: [recipeId], references: [id])
}

model Category {
  id  Int  @id @default(autoincrement())
  name String @unique
  type CategoryType
  recipes    Recipe[]  
}

enum CategoryType {
  MealType         // e.g. Breakfast, Dinner
  MainIngredient   // e.g. Chicken, Tofu
  Cuisine          // e.g. Italian, Japanese
  DietaryPreference // e.g. Vegan, Gluten-Free
  CookingMethod    // e.g. Air Fryer, Grilled
  Occasion         // e.g. Holiday, Party
  SkillLevel       // e.g. Beginner, Advanced
  PreparationTime  // e.g. Under30Minutes
  Equipment        // e.g. SlowCooker, InstantPot
  Audience         // e.g. KidFriendly, BudgetFriendly
  NutritionFocus   // e.g. HighProtein, LowFat
  Seasonality      // e.g. Summer, Winter
  FlavorProfile    // e.g. Spicy, Sweet
  Texture          // e.g. Crunchy, Creamy
}