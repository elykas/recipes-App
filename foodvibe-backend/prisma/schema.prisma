generator client {
  provider = "prisma-client-js"
  seed     = "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    Int               @id @default(autoincrement())
  publicId              String            @unique @default(uuid())
  email                 String?           @unique
  username              String            @unique
  fullName              String?
  phone                 String?           @unique
  imageUrl              String?
  bio                   String?
  headLine              String?
  birthDate             DateTime?
  isAdmin               Boolean           @default(false)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  lastLogin             DateTime?         @default(now())
  agreedToPolicy        Boolean           @default(false)
  agreedToPolicyDate    DateTime
  agreedToPolicyVersion String
  locale                String            @default("en")
  score                 Float?            @default(0)
  scoreUpdatedAt        DateTime?         @default(now())
  siteLink              String?
  comments              Comment[]         @relation("UserComments")
  favoriteRecipe        FavoriteRecipes[] @relation("UserFavoritesRecipes")
  userFeedBack          Feedback[]        @relation("UserFeedback")
  followers             Follow[]          @relation("UserFollowers")
  following             Follow[]          @relation("UserFollowing")
  createdGroups         Group[]           @relation("UserCreatedGroups")
  userGroups            GroupMember[]     @relation("UserGroups")
  groupRecipes          GroupRecipe[]     @relation("UserAddedRecipes")
  notifications         Notification[]    @relation("UserNotifications")
  posts                 Post[]            @relation("UserPosts")
  postLike              PostLike[]        @relation("UserPostLikes")
  recipes               Recipe[]          @relation("UserRecipes")
  recipeLike            RecipeLike[]      @relation("UserRecipeLikes")
  reporterReports       Report[]          @relation("ReporterReports")
  reportedReports       Report[]          @relation("ReportedUserReports")
  userEvents            UserEvent[]       @relation("UserEvents")
}

model Recipe {
  id             Int               @id @default(autoincrement())
  publicId       String            @unique @default(uuid())
  title          String
  prepTime       Int?              @default(30)
  difficulty     DifficultyLevel   @default(Easy)
  isPublic       Boolean           @default(false)
  imageUrl       String?
  description    String?
  tip            String[]
  score          Float?            @default(0)
  scoreUpdatedAt DateTime?
  authorId       Int
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  comments       Comment[]
  favoriteRecipe FavoriteRecipes[]
  ingredients    Ingredient[]
  posts          Post[]
  author         User              @relation("UserRecipes", fields: [authorId], references: [id], onDelete: Cascade)
  likes          RecipeLike[]
  likeCount      Int               @default(0)
  tags           RecipeTag[]
  reports        Report[]          @relation("ReportedRecipes")
  steps          Step[]
  categories     Category[]        @relation("CategoryToRecipe")
  groupRecipes   GroupRecipe[]

  @@unique([createdAt, publicId])
  @@unique([likeCount, publicId])
  @@index([title])
}

model Ingredient {
  id       Int     @id @default(autoincrement())
  name     String
  quantity String?
  unit     String?
  imageUrl String?
  recipeId Int
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Category {
  id      Int          @id @default(autoincrement())
  name    String       @unique
  type    CategoryType
  recipes Recipe[]     @relation("CategoryToRecipe")
}

model Step {
  id          Int     @id @default(autoincrement())
  title       String?
  description String
  imageUrl    String?
  duration    Int?
  recipeId    Int
  order       Int
  recipe      Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Group {
  id           Int           @id @default(autoincrement())
  publicId     String        @unique @default(uuid())
  name         String
  description  String?
  imageUrl     String?
  creatorId    Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  creator      User?         @relation("UserCreatedGroups", fields: [creatorId], references: [id])
  members      GroupMember[]
  groupRecipes GroupRecipe[]
}

model GroupMember {
  id       Int      @id @default(autoincrement())
  userId   Int
  groupId  Int
  admin    Boolean  @default(false)
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation("UserGroups", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model GroupRecipe {
  id        Int      @id @default(autoincrement())
  groupId   Int
  recipeId  Int
  addedById Int?
  addedAt   DateTime @default(now())

  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  recipe  Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  addedBy User?  @relation("UserAddedRecipes", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([groupId, recipeId])
}

model FavoriteRecipes {
  id        Int      @id @default(autoincrement())
  userId    Int
  recipeId  Int
  createdAt DateTime @default(now())
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user      User     @relation("UserFavoritesRecipes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
}

model Post {
  id             Int        @id @default(autoincrement())
  publicId       String     @unique @default(uuid())
  content        String?
  imageUrl       String
  score          Float?     @default(0)
  type           PostType   @default(Image)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  scoreUpdatedAt DateTime?
  comments       Comment[]
  author         User       @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade)
  authorId       Int
  recipe         Recipe?    @relation(fields: [recipeId], references: [id])
  recipeId       Int?
  likes          PostLike[] @relation("PostLikes")
  likeCount      Int        @default(0)
  tags           PostTag[]  @relation("PostTags")
  reports        Report[]   @relation("ReportedPosts")

  @@unique([createdAt, publicId])
  @@unique([likeCount, publicId])
}

model PostLike {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  type      LikeType @default(Like)
  createdAt DateTime @default(now())
  post      Post     @relation("PostLikes", fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation("UserPostLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model RecipeLike {
  id        Int      @id @default(autoincrement())
  userId    Int
  recipeId  Int
  type      LikeType @default(Like)
  createdAt DateTime @default(now())
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user      User     @relation("UserRecipeLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
}

model Comment {
  id        Int       @id @default(autoincrement())
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  authorId  Int
  recipeId  Int?
  postId    Int?
  parentId  Int?
  author    User      @relation("UserComments", fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentThread")
  post      Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  recipe    Recipe?   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  reports   Report[]  @relation("ReportedComments")
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Tag {
  id        Int         @id @default(autoincrement())
  publicId  String      @unique @default(uuid())
  name      String      @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  posts     PostTag[]
  recipes   RecipeTag[]
}

model PostTag {
  id     Int  @id @default(autoincrement())
  postId Int
  tagId  Int
  post   Post @relation("PostTags", fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
}

model RecipeTag {
  id       Int    @id @default(autoincrement())
  recipeId Int
  tagId    Int
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([recipeId, tagId])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
}

model UserEvent {
  id        Int       @id @default(autoincrement())
  userId    Int
  eventType EventType
  metadata  Json?
  createdAt DateTime  @default(now())
  user      User      @relation("UserEvents", fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id             Int          @id @default(autoincrement())
  reporterId     Int
  reporterUserId Int
  type           ReportType
  reason         String?
  status         ReportStatus @default(Pending)
  createdAt      DateTime     @default(now())
  postId         Int?
  commentId      Int?
  recipeId       Int?
  comment        Comment?     @relation("ReportedComments", fields: [commentId], references: [id], onDelete: Cascade)
  post           Post?        @relation("ReportedPosts", fields: [postId], references: [id], onDelete: Cascade)
  recipe         Recipe?      @relation("ReportedRecipes", fields: [recipeId], references: [id], onDelete: Cascade)
  reporter       User         @relation("ReporterReports", fields: [reporterId], references: [id])
  reportedUser   User         @relation("ReportedUserReports", fields: [reporterUserId], references: [id])
}

model Feedback {
  id        Int      @id @default(autoincrement())
  userId    Int?
  content   String
  createdAt DateTime @default(now())
  user      User?    @relation("UserFeedback", fields: [userId], references: [id])
}

enum DifficultyLevel {
  Easy
  Medium
  Hard
}

enum CategoryType {
  MealType
  MainIngredient
  Cuisine
  DietaryPreference
  CookingMethod
  Occasion
  SkillLevel
  PreparationTime
  Equipment
  Audience
  NutritionFocus
  Seasonality
  FlavorProfile
  Texture
}

enum PostType {
  TextBg
  Image
  Video
}

enum LikeType {
  Yummy
  Hungry
  MustTry
  Foodgasm
  TastesLikesHome
  NotForMe
  TooSpicy
  Like
}

enum NotificationType {
  Like
  Comment
  Follow
  NewPost
  NewRecipe
  System
  CommentReply
  Mention
  Search
  WeeklyDigest
  Trending
  TagFollowed
}

enum EventType {
  Login
  Logout
  ViewRecipe
  ViewPost
  CreateRecipe
  CreatePost
  Like
  Comment
  Follow
  Unfollow
  UpadateProfile
  Search
  Share
  ClickNotification
}

enum ReportType {
  Post
  Comment
  Recipe
}

enum ReportStatus {
  Pending
  Reviewed
  Rejected
  Resolved
}

model Policy {
  id        Int        @id @default(autoincrement())
  type      PolicyType
  version   String
  language  String
  content   String
  createdAt DateTime   @default(now())
}

enum PolicyType {
  TermsOfService
  PrivacyPolicy
  CookiePolicy
}

